# Dependencies
node_modules/
.pnpm-store/

# Build output (publish from src, dist is built on npm publish)
dist/
*.tsbuildinfo

# Site 本地资产 (由 scripts/copy-site-assets.mjs 在 site predev/prebuild 时自动写入)
site/public/matrix-rain/
site/public/atlas/
site/dist/

# 内部任务跟踪（每轮 AI 工作的临时 todo，不进 git）
task.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Environment
.env
.env.local
.env.*.local

# OS
Thumbs.db

# Test
coverage/
.nyc_output/
.playwright/
.playwright-cli/
test/_probe-webgpu.mjs
test/theme-transition.mjs
# pixel baseline 由 MATRIX_RAIN_PIXEL_BASELINE_MODE=init 录制,默认不入库
# 评审后用 `git add -f test/fixtures/baselines/` 显式提交,commit message 加 [pixel-update]
test/fixtures/baselines/

# Misc
.cache/
.tmp/

